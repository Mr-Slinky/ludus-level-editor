<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.slinky</groupId>
  <artifactId>ludus-level-editor</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>Ludus Level Editor</name>
  <description>A desktop tool that writes Ludus level files.</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>

    <!-- Dependency versions -->
    <gson.version>2.14.0</gson.version>
    <ludus-ui.version>1.0.0</ludus-ui.version>
    <junit.version>5.12.2</junit.version>

    <!-- Plugin versions -->
    <maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.3</maven-surefire-plugin.version>
    <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
    <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
    <maven-clean-plugin.version>3.4.0</maven-clean-plugin.version>
    <maven-dependency-plugin.version>3.8.1</maven-dependency-plugin.version>
    <exec-maven-plugin.version>3.5.0</exec-maven-plugin.version>

    <!-- The application that jlink and jpackage build, under the dist profile -->
    <app.module>com.slinky.ludus.editor</app.module>
    <app.main.class>com.slinky.ludus.editor.Editor</app.main.class>
    <app.name>Ludus Level Editor</app.name>
    <app.vendor>Slinky</app.vendor>

    <dist.modules.dir>${project.build.directory}/modules</dist.modules.dir>
    <dist.runtime.dir>${project.build.directory}/runtime</dist.runtime.dir>
    <dist.image.dir>${project.build.directory}/dist</dist.image.dir>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>${gson.version}</version>
    </dependency>

    <dependency>
      <groupId>com.slinky.ludus</groupId>
      <artifactId>ludus-ui</artifactId>
      <version>${ludus-ui.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>${maven-jar-plugin.version}</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-environment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.8.1,)</version>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>[25,)</version>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      mvn clean package -Pdist builds target/dist/Ludus Level Editor, a directory holding the launcher, the
      application module and a runtime cut to the modules that the editor requires. Copying that directory to
      another Windows machine is all that running it takes.
    -->
    <profile>
      <id>dist</id>

      <build>
        <plugins>
          <!-- jlink and jpackage both refuse to write over an output directory, so each run starts clean. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-clean-plugin</artifactId>
            <version>${maven-clean-plugin.version}</version>
            <executions>
              <execution>
                <id>clear-dist-output</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>clean</goal>
                </goals>
                <configuration>
                  <excludeDefaultDirectories>true</excludeDefaultDirectories>
                  <filesets>
                    <fileset>
                      <directory>${dist.modules.dir}</directory>
                    </fileset>
                    <fileset>
                      <directory>${dist.runtime.dir}</directory>
                    </fileset>
                    <fileset>
                      <directory>${dist.image.dir}</directory>
                    </fileset>
                  </filesets>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <!-- jlink resolves com.google.gson from the module path, so the jar is put where it can find it. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>${maven-dependency-plugin.version}</version>
            <executions>
              <execution>
                <id>collect-modules</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>copy-dependencies</goal>
                </goals>
                <configuration>
                  <outputDirectory>${dist.modules.dir}</outputDirectory>
                  <includeScope>runtime</includeScope>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>${exec-maven-plugin.version}</version>
            <executions>
              <!-- Links the editor, Gson and the JDK modules that both reach into one runtime image. -->
              <execution>
                <id>link-runtime</id>
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${java.home}/bin/jlink</executable>
                  <arguments>
                    <argument>--module-path</argument>
                    <argument>${project.build.directory}/${project.build.finalName}.jar${path.separator}${dist.modules.dir}</argument>
                    <argument>--add-modules</argument>
                    <argument>${app.module}</argument>
                    <argument>--output</argument>
                    <argument>${dist.runtime.dir}</argument>
                    <argument>--strip-debug</argument>
                    <argument>--no-header-files</argument>
                    <argument>--no-man-pages</argument>
                    <argument>--compress=zip-6</argument>
                  </arguments>
                </configuration>
              </execution>

              <!-- Wraps that runtime in a launcher, which starts the editor without a JDK installed. -->
              <execution>
                <id>package-image</id>
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${java.home}/bin/jpackage</executable>
                  <arguments>
                    <argument>--type</argument>
                    <argument>app-image</argument>
                    <argument>--name</argument>
                    <argument>${app.name}</argument>
                    <argument>--app-version</argument>
                    <argument>${project.version}</argument>
                    <argument>--vendor</argument>
                    <argument>${app.vendor}</argument>
                    <argument>--dest</argument>
                    <argument>${dist.image.dir}</argument>
                    <argument>--runtime-image</argument>
                    <argument>${dist.runtime.dir}</argument>
                    <argument>--module</argument>
                    <argument>${app.module}/${app.main.class}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
